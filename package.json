{
  "name": "midi-piano-player",
  "version": "1.0.0",
  "description": "MIDI钢琴播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "author": "繁花似锦",
  "license": "MIT",
  "dependencies": {
    "midi-file": "^1.2.4"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.yourname.midipianoplayer",
    "productName": "MIDI钢琴播放器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pianoKeys.js",
      "midiPlayer.js",
      "renderer/**/*",
      "images/**/*",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "midi_controller.py",
        "to": "midi_controller.py"
      },
      {
        "from": "midi_controller.exe",
        "to": "midi_controller.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "allowElevation": true
    },
    "npmRebuild": false
  }
}